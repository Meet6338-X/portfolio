# ─── OpenRouter API (AI Chatbot) ───────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
# Add this to your Vercel project settings too!
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── GitHub API (optional — increases rate limit for repo auto-sync) ────────
# Get a token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=ghp_your-token-here

# ─── Site URL (used for OpenGraph / SEO) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# ─── Formspree (optional — contact form submissions) ────────────────────────
# Create a free form at https://formspree.io/
NEXT_PUBLIC_FORMSPREE_ID=your-formspree-id
